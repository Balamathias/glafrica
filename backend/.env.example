# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Core Django ---
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database toggle ---
# "local"  -> uses the DB_NAME/DB_USER/... block below (your local Postgres)
# "prod"   -> uses DB_URL below, exactly like Vercel does (default, untouched)
DB_MODE=local

# Used when DB_MODE=local
DB_NAME=glafrica
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Used when DB_MODE=prod (pull the real value from Vercel project settings;
# never commit it). Vercel itself never sets DB_MODE, so it always takes
# this branch regardless of what's in this file.
DB_URL=

# --- Cloudinary (media storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Email ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@greenlivestockafrica.com
ADMIN_EMAIL=info@greenlivestockafrica.com

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
